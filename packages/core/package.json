{
  "name": "@cp949/simple-html-editor-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "React에 의존하지 않는 HTML 편집기 정책과 Tiptap extension 집합",
  "keywords": [
    "html",
    "editor",
    "wysiwyg",
    "tiptap",
    "prosemirror",
    "headless"
  ],
  "homepage": "https://github.com/cp949/simple-html-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/simple-html-editor.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/cp949/simple-html-editor/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json && node scripts/write-dist-package.mjs",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs",
    "test": "vitest run --root ../.. packages/core/test",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
