{
  "name": "@cp949/simple-html-editor-react",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "서버 HTML을 불러와 편집하고 정규화 HTML로 돌려주는 React 제어형 WYSIWYG 편집기",
  "keywords": [
    "html",
    "editor",
    "wysiwyg",
    "react",
    "tiptap",
    "prosemirror"
  ],
  "homepage": "https://github.com/cp949/simple-html-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/simple-html-editor.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/cp949/simple-html-editor/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json && node scripts/write-dist-package.mjs",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs",
    "test": "vitest run --root ../.. packages/react/test",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@cp949/simple-html-editor-core": "workspace:*",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "lucide-react": "^1.33.0"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
