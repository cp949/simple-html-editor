{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".bundle/**"]
    },
    "@cp949/simple-html-editor-consumer#build": {
      "dependsOn": ["@cp949/simple-html-editor-react#build"],
      "outputs": ["dist/**"]
    },
    "@cp949/simple-html-editor-consumer-react18#build": {
      "dependsOn": ["@cp949/simple-html-editor-react#build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
